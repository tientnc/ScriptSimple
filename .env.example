OPENROUTER_API_KEY=your_key_here
# Free at the time of writing; accepts image input and returns text.
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# Keep the upstream attempt below Netlify's platform timeout.
OPENROUTER_REQUEST_TIMEOUT_MS=24000
EXTRACTION_PROVIDER=openrouter
# For Gemini, set EXTRACTION_PROVIDER=gemini and configure these values.
GEMINI_API_KEY=your_key_here
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
